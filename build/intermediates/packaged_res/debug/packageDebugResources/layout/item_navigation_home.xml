<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_home_item"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">
    <FrameLayout android:id="@+id/nav_home_indicator" android:layout_width="64dp" android:layout_height="32dp" android:foreground="?attr/selectableItemBackground">
        <TextView android:id="@+id/nav_home_icon" style="@style/Widget.Folio.Navigation.Item.Icon" android:text="⌂" />
    </FrameLayout>
    <TextView android:id="@+id/nav_home_label" style="@style/Widget.Folio.Navigation.Item.Label" android:text="@string/folio_nav_home" />
</LinearLayout>
