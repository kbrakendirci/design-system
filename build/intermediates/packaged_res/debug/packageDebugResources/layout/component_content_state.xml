<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Folio.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">
        <ProgressBar
            android:id="@+id/state_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="?attr/folioColorPrimary" />
        <TextView
            android:id="@+id/state_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="?attr/folioColorPrimary"
            android:textSize="28sp" />
        <TextView
            android:id="@+id/state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/folio_empty_title"
            android:textAppearance="@style/TextAppearance.Folio.Title"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/folio_empty_message"
            android:textAppearance="@style/TextAppearance.Folio.Label"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/state_action"
            style="@style/Widget.Folio.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/folio_retry" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
